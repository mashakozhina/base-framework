# Copy this file to .env and fill in the values for your task:
#   cp .env.example .env

# Base URL the UI tests navigate against.
BASE_URL=https://saucedemo.com

# Credentials used by tests/auth.setup.ts to log in once and save a
# reusable session for the rest of the suite.
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce
