# Copy this file to .env and fill in the values for your task:
#   cp .env.example .env

# Base URL the API tests send requests against.
BASE_URL=https://wizard-world-api.herokuapp.com

# Basic auth credentials. Sent as "Authorization: Basic base64(username:password)"
# when both are set. Leave empty for APIs (like the wizard-world-api example) that don't need auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
